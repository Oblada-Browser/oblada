+// Oblada: how much taller than usual the address bar is (floating over the page;
+// see oblada/browser/ui/floating_location_bar.h), for the hole to fit it.
+int ExtraLocationBarHeight(const views::View* top_background) {
+  const LocationBar* location_bar =
+      static_cast<const TopBackgroundView*>(top_background)->location_bar();
+  return location_bar
+             ? std::max(0, location_bar->Bounds().height() -
+                               GetLayoutConstant(
+                                   LayoutConstant::kLocationBarHeight))
+             : 0;
+}
+
 BEGIN_VIEW_BUILDER(/* no export*/, TopBackgroundView, views::View)
 END_VIEW_BUILDER
 
