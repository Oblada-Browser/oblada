@@ -4,6 +4,9 @@
 
 #include "chrome/browser/metrics/chrome_feature_list_creator.h"
 
+#include "chrome/browser/browser_features.h"  // Oblada
+#include "oblada/browser/barrier/barrier.h"  // Oblada
+
 #include <vector>
 
 #include "base/command_line.h"
@@ -238,11 +241,21 @@ void ChromeFeatureListCreator::SetUpFieldTrials() {
 
   variations::VariationsService* variations_service =
       metrics_services_manager_->GetVariationsService();
-  variations_service->SetUpFieldTrials(
