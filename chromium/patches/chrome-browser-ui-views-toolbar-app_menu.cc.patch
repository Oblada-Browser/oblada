+// Oblada: from a button on the left of the window (in the sidebar) the menu opens
+// to the right, over the page, rather than squeezed between it and the screen edge.
+views::MenuAnchorPosition AnchorPositionFor(const views::Widget* parent,
+                                            const gfx::Rect& anchor_bounds) {
+  const bool on_left =
+      parent && anchor_bounds.CenterPoint().x() <
+                    parent->GetWindowBoundsInScreen().CenterPoint().x();
+  // Anchor positions are mirrored in RTL.
+  return on_left != base::i18n::IsRTL() ? views::MenuAnchorPosition::kTopLeft
+                                        : views::MenuAnchorPosition::kTopRight;
+}
+
 }  // namespace
 
