@@ -1496,6 +1497,18 @@ void MediaDevices::DevicesEnumerated(
   }
 
   ReportCompletedEnumerateDevices(result_contains_nonempty_input_device_ids);
+  // Oblada: in another order (but the first), for fingerprinting protection
+  // (as Brave).
+  ExecutionContext* oblada_context = ExecutionContext::From(script_state);
+  if (oblada_farbling::IsOn(oblada_context, oblada_farbling::kMediaDevices)) {
