 namespace {
 
+// Oblada: puts `view` out of sight in a quiet address bar (see
+// LocationBarView::IsObladaQuiet()), leaving nothing of it drawn: e.g. a hover
+// highlight, which is on a layer of its own and would stay where the view was,
+// or a button's icon, which goes on a layer of its own above the highlight and
+// would show above the bar (see ShowObladaQuietView()).
+void HideObladaQuietView(views::View* view) {
+  if (!view->bounds().IsEmpty()) {
+    std::vector<views::View*> pending = {view};
+    while (!pending.empty()) {
+      views::View* current = pending.back();
+      pending.pop_back();
+      if (views::InkDropHost* ink_drop = views::InkDrop::Get(current);
+          ink_drop && ink_drop->HasInkDrop()) {
+        ink_drop->GetInkDrop()->SetHovered(false);
+        ink_drop->GetInkDrop()->SnapToHidden();
+      }
+      for (views::View* child : current->children()) {
+        pending.push_back(child);
+      }
+    }
+  }
+  view->SetBoundsRect(gfx::Rect());
+  if (!view->layer()) {
+    view->SetPaintToLayer();
+    view->layer()->SetFillsBoundsOpaquely(false);
+  }
+  view->layer()->SetMasksToBounds(true);
+}
+
+// Oblada: undoes HideObladaQuietView()'s clip, for `view` to show again (its focus
+// ring is drawn around it).
+void ShowObladaQuietView(views::View* view) {
+  if (view && view->layer()) {
+    view->layer()->SetMasksToBounds(false);
+  }
+}
+
 int IncrementalMinimumWidth(const views::View* view) {
   return (view && view->GetVisible()) ? view->GetMinimumSize().width() : 0;
 }
