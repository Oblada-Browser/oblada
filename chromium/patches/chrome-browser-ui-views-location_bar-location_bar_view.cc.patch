+
+bool LocationBarView::IsObladaQuiet() const {
+  if (is_popup_mode_ || !oblada::sidebar::HasSidebarLocationBar(parent())) {
+    return false;
+  }
+  // Nor while it floats over the page, or a bubble of one of its buttons is
+  // open (which would lose its anchor).
+  if (oblada::sidebar::IsLocationBarFloating(this) || HasObladaBubble()) {
+    return false;
+  }
+  return !IsMouseHovered() && !omnibox_view_->HasFocus() &&
+         !GetOmniboxController()->edit_model()->user_input_in_progress();
+}
+
+bool LocationBarView::IsObladaSiteInfoInPanel() {
+  // Oblada: but while it's edited, when the icon is the suggestion's.
+  return !is_popup_mode_ &&
+         oblada::sidebar::HasSidebarLocationBar(parent()) &&
+         oblada::site_panel::SitePanelButtonOf(this) &&
+         !oblada::sidebar::IsLocationBarFloating(this) &&
+         !omnibox_view_->HasFocus() &&
+         !GetOmniboxController()->edit_model()->user_input_in_progress();
+}
+
+bool LocationBarView::HasObladaBubble() const {
+  const views::Widget* widget = GetWidget();
+  if (!widget) {
+    return false;
+  }
+  for (const views::Widget* owned :
+       views::Widget::GetAllOwnedWidgets(widget->GetNativeView())) {
+    const views::BubbleDialogDelegate* bubble =
+        owned->IsVisible() && !owned->IsClosed() && owned->widget_delegate()
+            ? owned->widget_delegate()->AsBubbleDialogDelegate()
+            : nullptr;
+    if (bubble && bubble->GetAnchorView() &&
+        Contains(bubble->GetAnchorView())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void LocationBarView::UpdateObladaQuiet() {
+  if (IsObladaQuiet() != oblada_quiet_) {
+    InvalidateLayout();
+  }
+}
+
+void LocationBarView::UpdateObladaFloating() {
+  if (is_popup_mode_ || !parent()) {
+    return;
+  }
+  BrowserView* browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  // Focused, or about to be again: the window's focus is elsewhere (e.g. in a
+  // bubble of the bar's) and comes back to it.
+  views::FocusManager* focus_manager = GetFocusManager();
+  const bool focused =
+      omnibox_view_->HasFocus() ||
+      (GetWidget() && !GetWidget()->IsActive() && focus_manager &&
+       focus_manager->GetStoredFocusView() == omnibox_view_);
+  const bool floating = browser_view && browser_view->multi_contents_view() &&
+                        oblada::sidebar::HasSidebarLocationBar(parent()) &&
+                        focused;
+  if (floating == oblada::sidebar::IsLocationBarFloating(this)) {
+    return;
+  }
+  oblada::sidebar::SetLocationBarFloating(
+      this, browser_view ? browser_view->multi_contents_view() : nullptr,
+      floating, GetLocationBarModel()->GetURLForDisplay());
+  // Floating, it shows the whole URL to edit, not just the site the sidebar
+  // shows: Chromium does that for the keyboard's focus, but not for a click's.
+  if (oblada::sidebar::IsLocationBarFloating(this)) {
+    GetOmniboxController()->edit_model()->Unelide();
+  }
+  // Larger text while floating.
+  const gfx::FontList font_list =
+      views::TypographyProvider::Get()
+          .GetFont(CONTEXT_OMNIBOX_PRIMARY, views::style::STYLE_PRIMARY)
+          .DeriveWithSizeDelta(
+              oblada::sidebar::IsLocationBarFloating(this)
+                  ? oblada::sidebar::kFloatingLocationBarFontDelta
+                  : 0);
+  omnibox_view_->SetFontList(font_list);
+  ime_inline_autocomplete_view_->SetFontList(font_list);
+  omnibox_additional_text_view_->SetFontList(font_list);
 }
 
