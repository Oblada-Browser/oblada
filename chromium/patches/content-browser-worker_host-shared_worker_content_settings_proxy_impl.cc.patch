+// Oblada
+void SharedWorkerContentSettingsProxyImpl::GetObladaFarbling(
+    GetObladaFarblingCallback callback) {
+  uint64_t token = 0;
+  uint32_t exceptions = 0;
+  bool reduce_language = false;
+  if (RenderProcessHost* process = owner_->GetProcessHost()) {
+    GetContentClient()->browser()->GetObladaWorkerFarbling(
+        process->GetBrowserContext(), process->GetStoragePartition(),
+        owner_->GetWorkerStorageKey(), &token, &exceptions, &reduce_language);
+  }
+  std::move(callback).Run(token, exceptions, reduce_language);
+}
