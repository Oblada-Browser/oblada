+// Oblada
+void ServiceWorkerContentSettingsProxyImpl::GetObladaFarbling(
+    GetObladaFarblingCallback callback) {
+  uint64_t token = 0;
+  uint32_t exceptions = 0;
+  bool reduce_language = false;
+  // May be shutting down.
+  if (context_wrapper_->browser_context() &&
+      context_wrapper_->storage_partition()) {
+    GetContentClient()->browser()->GetObladaWorkerFarbling(
+        context_wrapper_->browser_context(),
+        context_wrapper_->storage_partition(), storage_key_, &token,
+        &exceptions, &reduce_language);
+  }
+  std::move(callback).Run(token, exceptions, reduce_language);
+}
