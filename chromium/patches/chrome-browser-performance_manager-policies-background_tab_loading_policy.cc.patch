+// Oblada: whether `page_node` is a pinned tab's (one of the Essentials).
+bool IsPinnedTab(const PageNode* page_node) {
+  base::WeakPtr<content::WebContents> contents = page_node->GetWebContents();
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents.get())
+               : nullptr;
+  return tab && tab->IsPinned();
+}
+
 }  // namespace
 
 // static
@@ -400,6 +410,27 @@ base::DictValue BackgroundTabLoadingPolicy::DescribeSystemNodeData(
 
 bool BackgroundTabLoadingPolicy::ShouldLoad(
     const PageNodeToLoadData& page_node_data) {
+  // Oblada: restored tabs load when they're opened, as in Firefox and Zen.
+  // Besides the ones showing, only pinned tabs and those known to work in the
+  // background (that show notifications, or update their title or icon) load
+  // at startup: unlike UsesBackgroundCommunication(), a site never seen
+  // doing it doesn't count.
+  if (!page_node_data.page_node->IsVisible() &&
+      !IsPinnedTab(page_node_data.page_node)) {
+    const PageNode* page_node = page_node_data.page_node;
+    SiteDataReader* reader = GetSiteDataReader(page_node);
+    const bool works_in_background =
+        page_node->GetNotificationPermissionStatus() ==
+            blink::mojom::PermissionStatus::GRANTED ||
+        (reader && (reader->UpdatesFaviconInBackground() ==
+                        SiteFeatureUsage::kSiteFeatureInUse ||
+                    reader->UpdatesTitleInBackground() ==
+                        SiteFeatureUsage::kSiteFeatureInUse));
+    if (!works_in_background) {
+      return false;
+    }
+  }
+
   if (tab_loads_started_ < min_tabs_to_load_) {
     return true;
   }
