@@ -400,6 +410,16 @@ base::DictValue BackgroundTabLoadingPolicy::DescribeSystemNodeData(
 
 bool BackgroundTabLoadingPolicy::ShouldLoad(
     const PageNodeToLoadData& page_node_data) {
+  // Oblada: restored tabs load when they're opened, as in Firefox and Zen.
+  // Besides the ones showing, only pinned tabs and those that work in the
+  // background (that show notifications, or update their title or icon) load
+  // at startup.
+  if (!page_node_data.page_node->IsVisible() &&
+      !page_node_data.UsesBackgroundCommunication() &&
+      !IsPinnedTab(page_node_data.page_node)) {
+    return false;
+  }
+
   if (tab_loads_started_ < min_tabs_to_load_) {
     return true;
   }
