 void OmniboxPopupPresenterBase::ShowWidget(base::TimeTicks show_request_time) {
+  // Oblada: not before the floating address bar has landed over the page (see
+  // oblada/browser/ui/floating_location_bar.h). Hiding meanwhile cancels it.
+  if (location_bar_ && oblada::sidebar::IsFloatingLocationBarLanding(
+                           location_bar_->BoundsInScreen())) {
+    visual_state_weak_factory_.InvalidateWeakPtrs();
+    is_deferred_ = true;
+    oblada::sidebar::WhenFloatingLocationBarLands(
+        location_bar_->BoundsInScreen(),
+        base::BindOnce(
+            [](base::WeakPtr<OmniboxPopupPresenterBase> presenter,
+               base::TimeTicks show_request_time) {
+              if (presenter) {
+                presenter->is_deferred_ = false;
+                presenter->ShowWidget(show_request_time);
+              }
+            },
+            visual_state_weak_factory_.GetWeakPtr(), show_request_time));
+    return;
+  }
