+// Oblada: as with the back button's history, holding the button down shows a
+// menu, here the containers to open the new tab in.
+bool NewTabButton::OnMousePressed(const ui::MouseEvent& event) {
+  if (event.IsOnlyLeftMouseButton() && GetEnabled()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&NewTabButton::ShowContainersMenu,
+                       long_press_factory_.GetWeakPtr()),
+        base::Milliseconds(500));
+  }
+  return TabStripControlButton::OnMousePressed(event);
+}
+
+void NewTabButton::OnMouseReleased(const ui::MouseEvent& event) {
+  long_press_factory_.InvalidateWeakPtrs();
+  TabStripControlButton::OnMouseReleased(event);
+}
+
+void NewTabButton::OnMouseCaptureLost() {
+  long_press_factory_.InvalidateWeakPtrs();
+  TabStripControlButton::OnMouseCaptureLost();
+}
+
+void NewTabButton::ShowContainersMenu() {
+  containers_menu_model_ =
+      oblada::containers::ContainersMenuModel::ForNewTab(browser_);
+  containers_menu_runner_ = std::make_unique<views::MenuRunner>(
+      containers_menu_model_.get(), views::MenuRunner::HAS_MNEMONICS,
+      base::BindRepeating(
+          [](NewTabButton* button) {
+            if (button->GetState() != STATE_DISABLED) {
+              button->SetState(STATE_NORMAL);
+            }
+          },
+          base::Unretained(this)));
+  // Look pressed while the menu is open; releasing the mouse then picks an item
+  // instead of opening a normal tab.
+  SetState(STATE_PRESSED);
+  containers_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+      views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kMouse);
+}
