+// Oblada: the window's BrowserView when `header` is in the sidebar, where a
+// group is a workspace (oblada/browser/workspaces/); else null.
+BrowserView* GetObladaBrowserView(const views::View* header,
+                                  TabStripOrientation orientation) {
+  return orientation == TabStripOrientation::kVertical && header->GetWidget()
+             ? BrowserView::GetBrowserViewForNativeWindow(
+                   header->GetWidget()->GetNativeWindow())
+             : nullptr;
+}
 
