+bool TabGroupHeaderView::ShowObladaWorkspaceMenu() {
+  // Oblada: the workspace's menu rather than the group's editor.
+  BrowserView* const browser_view =
+      orientation_ == TabStripOrientation::kVertical && GetWidget()
+          ? BrowserView::GetBrowserViewForNativeWindow(
+                GetWidget()->GetNativeWindow())
+          : nullptr;
+  if (!browser_view) {
+    return false;
+  }
+  oblada::workspaces::ShowWorkspaceMenu(
+      browser_view->browser(), tab_group_visual_data_.title(),
+      editor_bubble_button_ && editor_bubble_button_->GetVisible()
+          ? static_cast<views::View*>(editor_bubble_button_)
+          : this);
+  return true;
+}
