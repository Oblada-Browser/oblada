+// static
+void WasmTtsEngineComponentInstallerPolicy::RegisterAndUpdateOnDemand() {
+  ComponentUpdateService* cus =
+      g_browser_process ? g_browser_process->component_updater() : nullptr;
+  if (!cus) {
+    return;
+  }
+  if (std::ranges::contains(cus->GetComponentIDs(), GetExtensionId())) {
+    UpdateWasmComponentOnDemand();
+    return;
+  }
+  auto installer = base::MakeRefCounted<ComponentInstaller>(
+      std::make_unique<WasmTtsEngineComponentInstallerPolicy>(
+          g_browser_process->local_state()));
+  installer->Register(cus, base::BindOnce(&UpdateWasmComponentOnDemand));
+}
+
 void RegisterWasmTtsEngineComponent(ComponentUpdateService* cus,
                                     PrefService* prefs) {
+  // Oblada: not for everyone, as Chromium does, but only once Reading mode has
+  // been opened, which registers the engine (`RegisterAndUpdateOnDemand()`):
+  // its last opening is forgotten after 90 days (`MaybeReinstallTtsEngine()`),
+  // and the engine is removed at the next start.
+  if (prefs->GetTime(::prefs::kAccessibilityReadAnythingDateLastOpened)
+          .is_null()) {
+    base::FilePath user_dir;
+    if (base::PathService::Get(DIR_COMPONENT_USER, &user_dir)) {
+      base::ThreadPool::PostTask(
+          FROM_HERE,
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+          base::GetDeletePathRecursivelyCallback(
+              user_dir.Append(FILE_PATH_LITERAL("WasmTtsEngine"))));
+    }
+    return;
+  }
   VLOG(1) << "Registering WASM TTS Engine component.";
   auto installer = base::MakeRefCounted<ComponentInstaller>(
       std::make_unique<WasmTtsEngineComponentInstallerPolicy>(prefs));
