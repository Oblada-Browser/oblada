+void MultiContentsViewDropTargetController::ShowInitiallyActiveTab(
+    TabDragTarget::DragController& controller) {
+  tabs::TabInterface* const initially_active =
+      controller.GetInitiallyActiveTab();
+  auto* const context =
+      const_cast<TabDragContext*>(controller.GetAttachedContext());
+  if (!initially_active || !context ||
+      context->GetWidget() != drop_target_parent_view_->GetWidget()) {
+    return;
+  }
+  TabStripModel* const model = context->GetTabStripModel();
+  const int index = model->GetIndexOfTab(initially_active);
+  const tabs::TabInterface* const active = model->GetActiveTab();
+  // Only in place of the tab being dragged, and not to show a split (which
+  // can't take another tab).
+  if (index == TabStripModel::kNoTab || !active || active == initially_active ||
+      active->GetContents() !=
+          controller.GetSessionData().source_dragged_contents() ||
+      initially_active->IsSplit()) {
+    return;
+  }
+  model->ActivateTabAt(index);
+}
