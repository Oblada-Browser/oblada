+// Oblada: the samples, scaled by a hair once pages read them, for
+// fingerprinting protection (oblada/blink/farbling.h).
+void AudioBuffer::ObladaFarble() {
+  if (oblada_farbled_) {
+    return;
+  }
+  oblada_farbled_ = true;
+  ExecutionContext* context =
+      CurrentExecutionContext(v8::Isolate::GetCurrent());
+  for (const auto& channel : channels_) {
+    if (channel) {
+      oblada_farbling::FarbleAudio(context, channel->AsSpan());
+    }
+  }
+}
