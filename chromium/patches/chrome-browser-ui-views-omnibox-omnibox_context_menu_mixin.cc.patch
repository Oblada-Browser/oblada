+GURL ObladaPageLink(LocationBar* location_bar, OmniboxController* controller) {
+  return location_bar && controller && location_bar->GetWebContents() &&
+                 !controller->edit_model()->user_input_in_progress()
+             ? location_bar->GetWebContents()->GetVisibleURL()
+             : GURL();
