+void TabStripCollectionController::CloseTabOrSelection(
+    const tabs::TabInterface* tab_interface,
+    CloseTabSource source) {
+  const std::optional<int> index = model_->GetIndexOfTab(tab_interface);
+  std::vector<const tabs::TabInterface*> selected;
+  if (index && model_->IsTabSelected(*index)) {
+    for (const tabs::TabInterface* tab :
+         model_->selection_model().selected_tabs()) {
+      selected.push_back(tab);
+    }
+  }
+  // Just the tab: when it's the only one selected, or the others are its split's
+  // (as when its split is the active tab).
+  const std::optional<split_tabs::SplitTabId> split = tab_interface->GetSplit();
+  if (std::ranges::all_of(selected, [&](const tabs::TabInterface* tab) {
+        return tab == tab_interface ||
+               (split.has_value() && tab->GetSplit() == split);
+      })) {
+    CloseTab(tab_interface, source);
+    return;
+  }
+  // The workspace shown keeps a New Tab page in place of its last tabs (see
+  // CloseTab()).
+  if (browser_view_ &&
+      oblada::workspaces::CloseLastTabs(browser_view_->browser(), selected)) {
+    return;
+  }
+  if (tab_closing_helper_) {
+    tab_closing_helper_->MaybeEnterTabClosingMode(std::nullopt, source);
+  }
+  model_->ExecuteContextMenuCommand(*index, tabs::CommandCloseTab);
+}
