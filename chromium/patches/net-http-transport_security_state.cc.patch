+SSLUpgradeDecision TransportSecurityState::GetSSLUpgradeDecision(
+    std::string_view host,
+    bool is_top_level_nav,
+    const NetLogWithSource& net_log,
+    const NetworkAnonymizationKey& key) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  base::AutoReset<std::optional<std::string>> partition(&partition_,
+                                                        PartitionFor(key));
+  return GetSSLUpgradeDecision(host, is_top_level_nav, net_log);
+}
+
+bool TransportSecurityState::AddHSTSHeader(std::string_view host,
+                                           std::string_view value,
+                                           const NetworkAnonymizationKey& key) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  base::AutoReset<std::optional<std::string>> partition(&partition_,
+                                                        PartitionFor(key));
+  return AddHSTSHeader(host, value);
+}
+
+// static
+std::optional<std::string> TransportSecurityState::PartitionFor(
+    const NetworkAnonymizationKey& key) {
+  if (!base::FeatureList::IsEnabled(features::kObladaPartitionHsts)) {
+    return std::nullopt;
+  }
+  const std::optional<SchemefulSite>& top_frame_site = key.GetTopFrameSite();
+  if (!top_frame_site) {
+    return std::nullopt;
+  }
+  // Opaque sites (sandboxed pages…) share one partition, apart from the others.
+  return top_frame_site->opaque()
+             ? std::string()
+             : std::string(top_frame_site->GetURL().host());
+}
+
+TransportSecurityState::HashedHost TransportSecurityState::STSKey(
+    base::span<const uint8_t> canonicalized_host) const {
+  if (!partition_) {
+    return HashHost(canonicalized_host);
+  }
+  const std::optional<std::string> dotted =
+      dns_names_util::NetworkToDottedName(canonicalized_host);
+  if (!dotted) {
+    return HashHost(canonicalized_host);
+  }
+  std::string site = registry_controlled_domains::GetDomainAndRegistry(
+      *dotted, registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (site.empty()) {
+    site = *dotted;
+  }
+  if (site == *partition_) {
+    return HashHost(canonicalized_host);
+  }
+  std::vector<uint8_t> partitioned(canonicalized_host.begin(),
+                                   canonicalized_host.end());
+  partitioned.push_back('/');
+  partitioned.insert(partitioned.end(), partition_->begin(), partition_->end());
+  return HashHost(partitioned);
+}
