diff --git a/chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h b/chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h
index 4fcb26f9e6..70d1e010d9 100644
--- a/chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h
+++ b/chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h
@@ -89,6 +89,22 @@ class VerticalTabStripStateController {
 
   using CollapseChangeCallback =
       base::RepeatingCallback<void(VerticalTabStripCollapseState)>;
+  // Oblada: whether the tab strip shows the workspace's header above its tabs
+  // (oblada/browser/workspaces/): only if the user wants it, and when it looks
+  // expanded, as it does when not collapsed or when expanded on hover (the
+  // compact sidebar's look is for its narrow width only). Its region view tells.
+  bool IsObladaShowingHeaders() const { return oblada_showing_headers_; }
+  void SetObladaShowingHeaders(bool showing) {
+    if (showing != oblada_showing_headers_) {
+      oblada_showing_headers_ = showing;
+      oblada_showing_headers_callback_list_.Notify(showing);
+    }
+  }
+  base::CallbackListSubscription RegisterOnObladaShowingHeadersChanged(
+      base::RepeatingCallback<void(bool)> callback) {
+    return oblada_showing_headers_callback_list_.Add(std::move(callback));
+  }
+
   virtual base::CallbackListSubscription RegisterOnCollapseChanged(
       CollapseChangeCallback callback);
 
@@ -118,6 +134,8 @@ class VerticalTabStripStateController {
  private:
   base::RepeatingCallbackList<void(VerticalTabStripCollapseState)>
       on_collapse_changed_callback_list_;
+  bool oblada_showing_headers_ = false;  // Oblada
+  base::RepeatingCallbackList<void(bool)> oblada_showing_headers_callback_list_;
   base::RepeatingCallbackList<void(bool)> on_resizing_changed_callback_list_;
   base::RepeatingCallbackList<void(bool)>
       on_expand_on_hover_enabled_changed_callback_list_;
