+// Oblada: Chromium's media button, a view of the toolbar's (see Init()).
+views::View* ObladaMediaButton(views::View* toolbar) {
+  for (views::View* child : toolbar->children()) {
+    if (child->GetClassName() == "MediaToolbarButtonView") {
+      return child;
+    }
+  }
+  return nullptr;
