# Oblada's own extension APIs (Firefox's, for Firefox add-ons), bundled apart from
# Chrome's: chrome/common/extensions/chrome_extensions_api_provider.cc adds their
# features and schemas to Chrome's, and
# chrome/browser/extensions/chrome_extensions_browser_api_provider.cc their functions
# (see //oblada/browser/extensions/api).

import("//tools/json_schema_compiler/json_features.gni")
import("//tools/json_schema_compiler/json_schema_api.gni")
import("//oblada/common/extensions/api/api_sources.gni")

group("api") {
  public_deps = [
    ":api_features",
    ":generated_api_json_strings",
    ":generated_api_types",
    ":manifest_features",
  ]
}

generated_json_strings("generated_api_json_strings") {
  sources = oblada_extensions_api_schema_sources
  bundle_name = "Oblada"
  root_namespace = oblada_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
  visibility = [ ":api" ]
}

generated_types("generated_api_types") {
  sources = oblada_extensions_api_schema_sources
  root_namespace = oblada_extensions_api_root_namespace
  deps = [ "//extensions/common/api" ]
  visibility = [ ":api" ]
}

json_features("api_features") {
  feature_type = "APIFeature"
  method_name = "AddObladaAPIFeatures"
  sources = [ "_api_features.json" ]
  visibility = [ ":api" ]
}

json_features("manifest_features") {
  feature_type = "ManifestFeature"
  method_name = "AddObladaManifestFeatures"
  sources = [ "_manifest_features.json" ]
  visibility = [ ":api" ]
}
