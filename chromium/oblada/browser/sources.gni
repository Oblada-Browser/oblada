# Oblada's version (oblada/VERSION, apart from Chromium's), for its code as
# OBLADA_VERSION in "oblada/version.h". Written when it changes, which rebuilds only
# the files that include it.
oblada_version = read_file("//oblada/VERSION", "trim string")
write_file("$root_gen_dir/oblada/version.h",
           [
             "// Generated from oblada/VERSION by oblada/browser/sources.gni.",
             "#ifndef OBLADA_VERSION_H_",
             "#define OBLADA_VERSION_H_",
             "#define OBLADA_VERSION \"$oblada_version\"",
             "#endif  // OBLADA_VERSION_H_",
           ])

# Firefox's lists of tracking parameters (clean_links/lists), as they are, for
# clean_links.cc as kStripOnShareList and kStripOnShareLgplList, and Mozilla's
# for mozilla_list.cc as kMozillaList, in "oblada/clean_links_lists.h". Written
# when they change.
write_file("$root_gen_dir/oblada/clean_links_lists.h",
           [
             "// Generated from oblada/browser/clean_links/lists by oblada/browser/sources.gni.",
             "#ifndef OBLADA_CLEAN_LINKS_LISTS_H_",
             "#define OBLADA_CLEAN_LINKS_LISTS_H_",
             "namespace oblada::clean_links {",
             "inline constexpr char kStripOnShareList[] = R\"json(",
             read_file("//oblada/browser/clean_links/lists/MPL2/StripOnShare.json",
                       "string"),
             ")json\";",
             "inline constexpr char kStripOnShareLgplList[] = R\"json(",
             read_file("//oblada/browser/clean_links/lists/LGPL/StripOnShareLGPL.json",
                       "string"),
             ")json\";",
             "inline constexpr char kMozillaList[] = R\"json(",
             read_file("//oblada/browser/clean_links/lists/mozilla/query-stripping.json",
                       "string"),
             ")json\";",
             "}  // namespace oblada::clean_links",
             "#endif  // OBLADA_CLEAN_LINKS_LISTS_H_",
           ])

# Brave's lists the Barrier starts from (barrier/lists), as they are, for its
# code in "oblada/barrier_lists.h"; and the resources of its ad-blocking engine
# (uBlock Origin's scriptlets and redirect resources, and Brave's), which
# chromium/scripts/barrier_resources.sh puts in the checkout, in
# "oblada/barrier_resources.h". Written when they change.
_barrier_lists = [
  [
    "kListCatalog",
    "list_catalog.json",
  ],
  [
    "kQueryFilterList",
    "query-filter.json",
  ],
  [
    "kDebounceList",
    "debounce.json",
  ],
  [
    "kSensitiveSitesList",
    "request-otr.json",
  ],
  [
    "kWebcompatExceptionsList",
    "webcompat-exceptions.json",
  ],
  [
    "kHttpsUpgradeExceptionsList",
    "https-upgrade-exceptions-list.txt",
  ],
]
_barrier_lists_header = [
  "// Generated from oblada/browser/barrier/lists by oblada/browser/sources.gni.",
  "#ifndef OBLADA_BARRIER_LISTS_H_",
  "#define OBLADA_BARRIER_LISTS_H_",
  "namespace oblada::barrier {",
]
foreach(list, _barrier_lists) {
  _barrier_lists_header += [
    "inline constexpr char ${list[0]}[] = R\"list(",
    read_file("//oblada/browser/barrier/lists/${list[1]}", "string"),
    ")list\";",
  ]
}
_barrier_lists_header += [
  "}  // namespace oblada::barrier",
  "#endif  // OBLADA_BARRIER_LISTS_H_",
]
write_file("$root_gen_dir/oblada/barrier_lists.h", _barrier_lists_header)
write_file("$root_gen_dir/oblada/barrier_resources.h",
           [
             "// Generated from third_party/oblada_barrier/resources.json by oblada/browser/sources.gni.",
             "#ifndef OBLADA_BARRIER_RESOURCES_H_",
             "#define OBLADA_BARRIER_RESOURCES_H_",
             "namespace oblada::barrier {",
             "inline constexpr char kEngineResources[] = R\"resources(",
             read_file("//third_party/oblada_barrier/resources.json", "string"),
             ")resources\";",
             "}  // namespace oblada::barrier",
             "#endif  // OBLADA_BARRIER_RESOURCES_H_",
           ])

